# Variáveis de produção do servidor próprio (Contabo).
# Uso: cp deploy/env.producao.example .env   (na raiz do repo; o .env fica fora do git)
# Senhas: gere com  openssl rand -hex 32  (só letras e números: entram em URLs).

# ---- Domínios -----------------------------------------------------------------
# App (o que as pessoas abrem) e subdomínio das fotos. Os dois apontam (DNS tipo A) para o IP do servidor.
# Sem domínio ainda? Use o sslip.io com o IP do servidor (ex.: IP 203.0.113.10):
#   DOMINIO_APP=app.203-0-113-10.sslip.io   DOMINIO_ARQUIVOS=arquivos.203-0-113-10.sslip.io
DOMINIO_APP=app.seudominio.com.br
DOMINIO_ARQUIVOS=arquivos.seudominio.com.br
# E-mail para avisos do certificado (Let's Encrypt).
ACME_EMAIL=voce@exemplo.com

# ---- Modo de rede -------------------------------------------------------------
# Padrão: o Caddy deste projeto atende as portas 80/443 e faz o HTTPS. Deixe tudo abaixo comentado.
# Se o servidor JÁ tem um proxy (nginx, Caddy, Traefik) nas portas 80/443, descomente:
# SITE_APP=http://app.seudominio.com.br
# SITE_ARQUIVOS=http://arquivos.seudominio.com.br
# WEB_PORTA_HTTP=127.0.0.1:8088
# WEB_PORTA_HTTPS=127.0.0.1:8443
# TRUST_PROXY_HOPS=2
# ...e no proxy existente encaminhe os DOIS domínios para http://127.0.0.1:8088, mantendo o Host original.

# ---- Senhas internas (gere com openssl rand -hex 32) ---------------------------
POSTGRES_PASSWORD=
JWT_SECRET=
MINIO_ROOT_USER=everest
MINIO_ROOT_PASSWORD=

# ---- Firebase (docs/CONTAS.md, passo 2) ----------------------------------------
FIREBASE_PROJECT_ID=
# Públicos (vão para o app): do bloco firebaseConfig do app Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
# SEGREDO: JSON da conta de serviço em base64, numa linha só:  base64 -w0 conta-servico.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ---- Pix da inscrição (X12) ----------------------------------------------------
# O "copia e cola" do QR estático de R$ 50 do embaixador (o texto longo que começa com 000201).
# Entre aspas: o código tem espaços.
PIX_COPIA_E_COLA=""

# ---- Notificações push (R22) ---------------------------------------------------
# Gere UMA vez:  npx web-push generate-vapid-keys   (trocar depois desliga o push de todos os aparelhos).
# A pública é servida pela API (GET /api/push/chave-publica); a privada é SEGREDO.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do remetente para os serviços de push (mailto: ou https://).
VAPID_SUBJECT=mailto:
