# Ignore específico do apps/web/Dockerfile (BuildKit usa este arquivo no lugar do .dockerignore
# da raiz, que é a lista branca da API). Lista branca: só o que o build do web precisa.
*

!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json

!packages/shared/package.json
!packages/shared/tsconfig.json
!packages/shared/tsup.config.ts
!packages/shared/src

!apps/api/package.json

!apps/web
apps/web/node_modules
apps/web/dist
apps/web/.env
apps/web/.env.*
apps/web/e2e
apps/web/test-results
apps/web/playwright-report

!deploy/Caddyfile
