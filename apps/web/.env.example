# URL pública do app (Q2). Usada pelo botão "Baixar o app" como fallback.
VITE_APP_URL=http://localhost:5173

# Firebase Auth (docs/FRONTEND.md §5.1). Valores públicos (vão para o bundle); nunca coloque segredos aqui.
# Dev: projeto demo do emulador (`pnpm emu`). Produção: os valores do Console do Firebase.
VITE_FIREBASE_API_KEY=demo-key
# Em produção, o domínio do próprio app (Q15), por causa do proxy /__/auth (seção 5.5).
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-everest
VITE_FIREBASE_APP_ID=demo-app
# Só dev: URL do emulador de Auth. Vazio em produção.
VITE_FIREBASE_EMULADOR=http://127.0.0.1:9099
