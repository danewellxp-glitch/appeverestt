NODE_ENV=development
PORT=3000
# Postgres local (docker-compose). Em produção use a URL do provedor gerenciado.
DATABASE_URL=postgresql://everest:everest@localhost:5432/everest?schema=public
REDIS_URL=redis://localhost:6379
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
WEB_ORIGIN=http://localhost:5173
# MinIO local (docker-compose). Em produção: Cloudflare R2.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=everest-provas
S3_ACCESS_KEY_ID=everest
S3_SECRET_ACCESS_KEY=everest-dev-secret
S3_FORCE_PATH_STYLE=true
PERMITIR_EDITAR_DIAS_ANTERIORES=false
# Proxies na frente da API (dev: 1; produção Vercel -> Railway: 2). Ver docs/DEPLOY.md.
TRUST_PROXY_HOPS=1
