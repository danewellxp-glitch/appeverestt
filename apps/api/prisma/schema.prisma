generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  USUARIO
  ADMIN
}

enum TipoFoto {
  AGUA
  EXERCICIO
  LEITURA
}

enum StatusFoto {
  PENDENTE
  ENVIADA
  CONFIRMADA
  REJEITADA
}

/// Pix manual (X12): PENDENTE = vaga reservada; INFORMADO = "Já fiz o pagamento"; CONFIRMADO = liberado pelo embaixador
enum StatusPagamento {
  PENDENTE
  INFORMADO
  CONFIRMADO
}

model Usuario {
  id                 String          @id @default(cuid())
  nome               String
  /// sempre salvo em lowercase + trim
  email              String          @unique
  /// uid do Firebase Auth (vinculado no POST /auth/sessao)
  firebaseUid        String?         @unique
  /// foto do Google (pode ser null)
  fotoUrl            String?
  /// só usuários legados/seed (login por senha atrás de AUTH_SENHA_LEGADO)
  senhaHash          String?
  papel              Papel           @default(USUARIO)
  /// incrementar invalida todas as sessões
  tokenVersao        Int             @default(0)
  /// null = perfil incompleto (precisa passar pela /bem-vindo)
  aceitouTermosEm    DateTime?
  /// Dados de cadastro (Q7): obrigatórios para se inscrever; null até a /bem-vindo
  /// usuário do Instagram, sem "@", minúsculo
  instagram          String?
  dataNascimento     DateTime?       @db.Date
  /// só dígitos com DDD, sem +55
  whatsapp           String?
  bairro             String?
  cidade             String?
  uf                 String?         @db.Char(2)
  /// consentimento separado para marketing (X9); null = não aceitou ou revogou
  aceitouMarketingEm DateTime?
  /// conta excluída (dados anonimizados; a vaga continua ocupada — X5)
  excluidoEm         DateTime?
  criadoEm           DateTime        @default(now())
  participacoes      Participante[]
  inscricoesPush     PushInscricao[]
}

model Desafio {
  id                  String         @id @default(cuid())
  slug                String         @unique
  nome                String
  dataInicio          DateTime       @db.Date
  totalDias           Int            @default(30)
  totalVagas          Int            @default(50)
  embaixadorOcupaVaga Boolean        @default(true)
  inscricoesAbertas   Boolean        @default(true)
  timezone            String         @default("America/Sao_Paulo")
  /// sem "@"
  instagramHandle     String
  /// sem "#"
  hashtag             String         @default("DESAFIO30EVEREST")
  ativo               Boolean        @default(false)
  criadoEm            DateTime       @default(now())
  participantes       Participante[]
}

model Participante {
  id                       String          @id @default(cuid())
  desafioId                String
  usuarioId                String
  /// null somente para embaixador quando embaixadorOcupaVaga = false
  vagaNumero               Int?
  ehEmbaixador             Boolean         @default(false)
  dataInscricao            DateTime        @default(now())
  /// só CONFIRMADO acessa check-in, ranking e feed; embaixador nasce CONFIRMADO
  pagamentoStatus          StatusPagamento @default(PENDENTE)
  /// último "Já fiz o pagamento" (mantido quando o admin volta para PENDENTE)
  pagamentoInformadoEm     DateTime?
  pagamentoConfirmadoEm    DateTime?
  pagamentoConfirmadoPorId String?
  desafio                  Desafio         @relation(fields: [desafioId], references: [id])
  usuario                  Usuario         @relation(fields: [usuarioId], references: [id])
  dias                     DiaDesafio[]
  feedback                 Feedback?

  @@unique([desafioId, usuarioId])
  @@unique([desafioId, vagaNumero])
}

model DiaDesafio {
  id                String       @id @default(cuid())
  participanteId    String
  numeroDia         Int
  aguaMl            Int          @default(0)
  exercicio         Boolean      @default(false)
  paginasLidas      Int          @default(0)
  storyPostado      Boolean      @default(false)
  /// DERIVADO: sempre recalculado no servidor
  concluido         Boolean      @default(false)
  invalidado        Boolean      @default(false)
  motivoInvalidacao String?
  invalidadoPorId   String?
  invalidadoEm      DateTime?
  /// aprovado pelo embaixador (X8); zera em qualquer edição do dia
  conferidoEm       DateTime?
  conferidoPorId    String?
  atualizadoEm      DateTime     @updatedAt
  participante      Participante @relation(fields: [participanteId], references: [id])
  fotos             FotoProva[]

  @@unique([participanteId, numeroDia])
  @@index([participanteId, concluido])
}

model FotoProva {
  id             String     @id @default(cuid())
  diaId          String
  tipo           TipoFoto
  storageKey     String
  thumbKey       String?
  mimeType       String
  tamanhoBytes   Int
  status         StatusFoto @default(PENDENTE)
  criadoEm       DateTime   @default(now())
  /// dHash de 64 bits (16 hex) da versão processada, calculado pelo worker (X20): só sinal de foto
  /// repetida para o embaixador. Null enquanto não processa, em imagem lisa e nas fotos de antes da
  /// R20 (preencher com `scripts/hash-fotos.ts`).
  hashPerceptual String?
  dia            DiaDesafio @relation(fields: [diaId], references: [id], onDelete: Cascade)

  /// Única por (dia, tipo) só entre as fotos que já chegaram (status <> PENDENTE): índice parcial
  /// "FotoProva_diaId_tipo_recebida_key" no SQL (migration troca_foto_sem_perda). Uma troca deixa a
  /// nova PENDENTE ao lado da antiga até a confirmação.
  @@index([diaId, tipo])
  @@index([status, criadoEm])
}

/// Feedback do participante (X13): 1 por participante; apagado junto com a inscrição
model Feedback {
  id                 String       @id @default(cuid())
  participanteId     String       @unique
  /// 1..5 (CHECK no SQL)
  nota               Int
  oQueAchou          String
  oQueMudou          String
  autorizaDivulgacao Boolean      @default(false)
  criadoEm           DateTime     @default(now())
  atualizadoEm       DateTime     @updatedAt
  participante       Participante @relation(fields: [participanteId], references: [id], onDelete: Cascade)
}

/// Aparelho com notificações push ativas (R22). Um endpoint por navegador/aparelho; se outra pessoa
/// entrar no mesmo aparelho, a inscrição muda de dono. Apagada na exclusão da conta (X5).
model PushInscricao {
  id            String    @id @default(cuid())
  usuarioId     String
  /// URL do serviço de push do navegador (única)
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  criadoEm      DateTime  @default(now())
  ultimoEnvioEm DateTime?
  /// erros seguidos (fora 404/410); a inscrição é apagada ao chegar a 5
  falhas        Int       @default(0)
  usuario       Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}
