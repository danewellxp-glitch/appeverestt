{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "isolatedModules": false,
    "outDir": "./dist",
    "baseUrl": "./",
    "removeComments": true,
    "incremental": true,
    "types": ["node", "jest"]
  },
  "include": ["src", "test", "prisma", "scripts"]
}
